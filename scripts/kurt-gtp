#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if command -v cabal >/dev/null 2>&1; then
  cabal v2-build >/dev/null
  exec "$(cabal list-bin kurt)" +RTS -N1
fi

for bin in ./dist-newstyle/build/*/ghc-*/kurt-*/x/kurt/build/kurt/kurt; do
  if [[ -x "$bin" ]]; then
    exec "$bin" +RTS -N1
  fi
done

if command -v nix >/dev/null 2>&1; then
  exec nix shell nixpkgs#ghc nixpkgs#cabal-install -c bash -lc '
    cd "$1"
    cabal v2-build >/dev/null
    exec "$(cabal list-bin kurt)" +RTS -N1
  ' bash "$PWD"
fi

echo "scripts/kurt-gtp: need cabal, nix, or an existing cabal build artifact" >&2
exit 127
